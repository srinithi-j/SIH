# Root-level reference only — each service also has its own .env.example
# (backend/.env.example, frontend/.env.example). When using docker-compose,
# these values are already wired in docker-compose.yml.

# --- PostgreSQL ---
POSTGRES_USER=sih_user
POSTGRES_PASSWORD=sih_password
POSTGRES_DB=sih_portal
DATABASE_URL=postgresql://sih_app:your_new_app_password@localhost:5432/sih_portal

# --- Backend ---
JWT_SECRET=change_this_dev_secret_before_deploying
AI_SERVICE_URL=http://localhost:8000

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:5000/api
